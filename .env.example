# Copy to .env, then generate three different values with:
# python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
KIWI_SECRET_KEY=
KIWI_DB_PASSWORD=
KIWI_DB_ROOT_PASSWORD=
KIWI_ALLOWED_HOSTS=localhost,127.0.0.1
KIWI_CSRF_TRUSTED_ORIGINS=https://localhost,https://127.0.0.1
KIWI_HTTPS_PORT=9443
# Same machine: 127.0.0.1. Browser outside a Linux VM: use 0.0.0.0.
KIWI_BIND_ADDRESS=127.0.0.1
# Optional: if Debian downloads are slow, use https://mirrors.ustc.edu.cn
DEBIAN_MIRROR=https://deb.debian.org
# Exact origins the interface runner may contact (comma-separated).
# Add your test service, e.g. http://192.168.190.128:8080
KIWI_API_ALLOWED_ORIGINS=http://api-demo:8080
# Display timezone for scheduled runs (the database stores UTC).
KIWI_TIME_ZONE=Asia/Shanghai
# Container log level: DEBUG, INFO, WARNING, ERROR.
KIWI_LOG_LEVEL=INFO
# Seconds a /ready/ probe may spend before it gives up. Keep this well below
# the uwsgi harakiri limit (30s), otherwise a hung database blocks workers.
KIWI_READINESS_TIMEOUT=3
# Upper bound for establishing a database connection, in seconds.
KIWI_DB_CONNECT_TIMEOUT=5
